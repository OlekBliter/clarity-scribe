# Root directory for runtime data. The application stores clarityscribe.db
# and the audio/ directory here. Leave empty to use the platform default,
# such as %APPDATA%/clarityscribe on Windows.
CLARITYSCRIBE_DATA_DIR=

# Google Gemini API key used by the S3/S4 clinical engine.
# Keep the real key only in your local .env file; never commit it.
GEMINI_API_KEY=

# Local Vosk model directory used by S1 audio transcription.
# This may be a relative path from the repository root or an absolute path.
VOSK_MODEL_DIR=models/vosk-model-small-uk-v3-small

# Local GLiNER model directory, including its local backbone/, used by S6 NER.
# This may be a relative path from the repository root or an absolute path.
GLINER_MODEL_DIR=models/gliner_multi-v2.1
